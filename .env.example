# --- Supabase (new EU project) ---
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Service role key — server-only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
# API key with $60/mo cap
ANTHROPIC_API_KEY=

# --- OpenAI (Whisper for Phase 2 voice) ---
# API key with $20/mo cap
OPENAI_API_KEY=

# --- Slack bot ---
# Bot User OAuth Token, starts with xoxb-
SLACK_BOT_TOKEN=
# Signing secret for verifying Slack request signatures
SLACK_SIGNING_SECRET=
# Channel ID of the DM between Matteo and the bot (starts with D...)
SLACK_MATTEO_DM_CHANNEL=

# --- Vercel Cron ---
# Random 32+ char string. Vercel Cron sends this as Authorization: Bearer
CRON_SECRET=

# --- Google (Phase 1+: Gmail / Calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
